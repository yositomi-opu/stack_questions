%__mcq_addCopt(%__Copt1, %__Cmsg1);
%__mcq_addCopt(%__Copt2, %__Cmsg2);
%__mcq_addCopt(%__Copt3, %__Cmsg3);
%__mcq_addCopt(%__Copt4, %__Cmsg4);
