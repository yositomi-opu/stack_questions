    </stackversion>
    <questionvariables>
      <text><![CDATA[/* binary tree 8 form template (試作) */
ma1:rand([2, 3, 5]);
ma2:rand(primes(7, 11));
check1(ans):=if mod(ans, ma1)=0 then true else false;
check2(ans):=if mod(ans, ma2)=0 then true else false;
checkA(ans):=block([bt:0], if check1(ans) then bt:bt+1, if check2(ans) then bt:bt+2, return(bt));
ta1:ma1*ma2;
CmsgL:makelist("", k, 1, 10);
WmsgL:makelist("", k, 1, 10);
CmsgL[1]:sconcat(ma1, "の倍数:なっています.");
CmsgL[2]:sconcat(ma2, "の倍数:なっています.");
WmsgL[1]:sconcat(ma1, "の倍数になっていません.");
WmsgL[2]:sconcat(ma2, "の倍数になっていません.");



]]></text>
    </questionvariables>
