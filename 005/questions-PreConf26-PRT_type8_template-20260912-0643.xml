    <name>
      <text>PRT_type8_template</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p><br></p>
<p>{@ma1@}の倍数でもあり, {@ma2@}の倍数でもあるものを1つ答えよ.</p>
<p>[[input:ans1]] [[validation:ans1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text></text>
    </generalfeedback>
