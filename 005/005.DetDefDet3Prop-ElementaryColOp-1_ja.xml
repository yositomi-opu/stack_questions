    </stackversion>
    <questionvariables>
      <text><![CDATA[/* 3次行列式の性質と列基本変形 */
/* v004 : 問題文のミスを修正 (2023.6.13) */
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.mac");
sz:3;
n:sz;
diag_mat(L):=block([l], l:length(L), return(genmatrix(lambda([i, j], if i=j then L[i] else 0), l, l)));
matA:matrix(makelist(Wa[i], i, 1, sz));
MtoTeX(M):=block([m, n, i, j, s], s:"\\begin{vmatrix}", [m, n]:matrix_size(M), for i:1 thru m do (for j:1 thru n do (s:sconcat(s, M[i, j]), if j<n then s:sconcat(s, "&")), if i<m then s:sconcat(s, "\\\\")), return(sconcat(s, "\\end{vmatrix}")));
aconv(s):=ssubst("a_1", "a1", ssubst("a_2", "a2", ssubst("a_3", "a3", ssubst("", "*", ssubst("", "(", ssubst("", ")", s))))));
vmat(m):=block([_lc:lmxchar, s], lmxchar:"|", s:tex1(m), lmxchar:_lc, return(s));

dA:vmat(matA);
aL:[-3, -2, -1, 1, 2, 3, 4, 5];
cL:[-2, -1, 2, 3];
X1:rand([kihonP(n, 1, 2, rand(aL)), kihonP(n, 1, 3, rand(aL)), kihonP(n, 2, 3, rand(aL))]);
X2:rand([kihonQ(n, 1, rand(cL)), kihonQ(n, 2, rand(cL)).kihonP(n, 1, 2, rand(aL)), kihonQ(n, 2, rand(cL)).kihonQ(n, 3, rand(cL))]);
X3:rand([diag_mat([rand(cL), rand(cL), rand(cL)]), kihonR(n, 1, 2).kihonR(n, 2, 3).kihonQ(n, 2, rand(cL))]);
Cans1:determinant(X1);
Cans2:determinant(X2);
Cans3:determinant(X3);
CansL:[Cans1, Cans2, Cans3];
m1:matA.X1;
m2:matA.X2;
m3:matA.X3;
mondai1:vmat(m1);
mondai2:vmat(m2);
mondai3:vmat(m3);
]]></text>
