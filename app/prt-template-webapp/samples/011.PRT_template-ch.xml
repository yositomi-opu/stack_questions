      <text><![CDATA[stack_include("https://yositomi-opu.github.io/stack_questions/ky_linear_algebra.mac");
stack_include("https://yositomi-opu.github.io/stack_questions/multilang_library.mac");
%_rw:3;
%_cl:5;
matP:random_matrix_det_list(3, [-2, -1, -1, -1, -1, 0, 1, 1, 1, 1, 2], [-1, 1]);
pv:rand([[1, 2], [1, 3], [1, 2, 3], [1, 2, 4]]);
matF:randechelon(3, 5, pv, [-2, -1, 1, 2]);
matA:matP.matF;
nL:nullspace2(matF);
taD:length(nL);/* or 5-length(pv) */
while length(nL)<7 do nL:endcons(EMPTYANSWER, nL);
ta1:nL[1];
ta2:nL[2];
ta3:nL[3];
ta4:nL[4];
