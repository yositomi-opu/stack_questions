BASE:%__lang([["ja", "基底"], ["en", "Basis"]]);
DIM:%__lang([["ja", "次元"], ["en", "Dim"]]);

%_Num_Nodes:7;

%_validate(ansL):=block([k, ret], ret:true,
  for k:1 thru 6 do ret:ret and (ansL[k]=EMPTYANSWER or is(matrix_size(ansL[k])=[%_cl, 1])), return(ret));
scL:[0.1, 0.1, 0.05, 0.2, 0.2, 0.2, 0.15];/* length must be %_Num_Nodes */
