        <text><![CDATA[ssc1:1.0/%_Num_Nodes;
scL:[0.1, 0.2, 0.2, 0.2, 0.1, 0.1, 0.05, 0.05];
ansL:[ans1, ans2, ans3, ans4, ans5, ans6, ansD];
chkV:%_validate(ansL);
FeedbackMsg:"";
/* %_chkfunc is check function for answer (ans1 or the whole answers) */
/* return value of %_chkfunc is [true, false, ... ] of length %_Num_Nodes+1 */
/* first entry represents which the answer is correct or not */
/* e.g. [false, true, false, true, true, true, false, true, false] */
/* or [true, true, true, true, true, true, true, true, true] */
if chkV then chkL:%_chkfunc(ansL) else chkL:makelist(false, %_Num_Nodes+1);

/* Assuming pre-defined feedback messages list (depend on %_STACK_LANG) : %_fmsgL */
/* %_fmsgL format: */
/* [["Msg when chk1 is true", "Msg when chk1 is false"], ["Msg when chk2 is true", "Msg when chk2 is false"],..] */
for k:1 thru %_Num_Nodes do 
  if chkL[k+1] then FeedbackMsg:sconcat(FeedbackMsg, %_fmsgL[k][1]) 
  else FeedbackMsg:sconcat(FeedbackMsg, %_fmsgL[k][2]);
/* Score should be computed before PRT */
sc:0;
for k:1 thru %_Num_Nodes do 
  if chkL[k+1] then sc:sc+scL[k];


]]></text>
