    <questionvariables>
      <text><![CDATA[/* Latest version is github/yositomi-opu/stack_question */
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.txt");
/* Number of [all options, correct options] (rb/radio button case does work) */
[oN, cN]:[5, 2];
/* key parameters(e.g. which control the only level of the question) here if required */
[rw, cl]:rand([[3, 4], [4, 5], [3, 5]]);
pv:rand([[1, 2], [1, 3], [1, 2, 3]]);
/*********************************** FLAGS ***********************************/
/* Flags: modification not required if not necessary */
/* Flags for mcq_template(before include pre template) */
/* The difference of -cb and -rb is only type of ans1(checkbox or radio button) and this setting */
__mcq_rb_cb:"rb";
/* cN:(min or max)(cN, # of all correct patterns), wN:(min or max)(oN_cN, # of all incorrect patterns) */
__mcq_min_max:min;
/* display feedback? ( true recommended ) */
__mcq_fbp:true;
/* use subscore ? cf. ATCM2022 Yoshitomi */
__mcq_subsc:true;
/* include "I have no idea option? " (default: false) */
__mcq_noidea:false;
/* include "nocorrect answer" option ? (default: false) */
__mcq_nocorrectopt:false;
/* if include nocorrect answer options, is it correct answer or not ? */
__mcq_nocorrecttrue:rand([true, false]);
/* add any of "choose one" or "choose all" automatically to question text ? (default: true) */
__mcq_qtext_auto:true;
/****************************** DO NOT EDIT HERE *****************************/
stack_include("https://stack.mathedu.jp/sc/mcq_template_pre.txt");
/*****************************************************************************/

/**************** QUESTION VARIABLES for MAIN CONTENT ****************/
/* 正答・誤答パターン生成用変数, 問題文生成 */
matF:randechelon(rw, cl, pv, [-2, -1, -1, 0, 1, 1, 2]);
matP:random_matrix_det_list(rw, [-2, -1, -1, 0, 1, 1, 2], [-1, 1]);
matA:matP.matF;
/* qtext : 問題文の主文(Main sentence for question text/"選べ"は自動) */
if %_STACK_LANG="ja" then qtext:sconcat("\\(A=", tex1(matA), "\\)のとき, 行簡約形として正しいものを __SELTYPE__.") else qtext:sconcat("When \\(A=", tex1(matA), "\\), then choose __SELTYPE__ as the row reduced echelonform.");
if %_STACK_LANG="ja" then _Cm1:"正解パターン1です." else _Cm1:"Correct pattern 1";
if %_STACK_LANG="ja" then _Cm2:"正解パターン2です." else _Cm2:"Correct pattern 2";
if %_STACK_LANG="ja" then _Wm1:"誤答パターン1です." else _Wm1:"Incorrect pattern 1";
if %_STACK_LANG="ja" then _Wm2:"誤答パターン1です." else _Wm2:"Incorrect pattern 2";
if %_STACK_LANG="ja" then _Wm3:"誤答パターン1です." else _Wm3:"Incorrect pattern 3";
/************************ Patterns ********************/
/* 正解/誤答のパターンとフィードバックをセットで List に push していく. */
addCopt(_rp(["Correct pattern1-1"]), _Cm1);
addCopt(_rp(["Correct pattern2-1"]), _Cm2);
addWopt(_rp(["Wpattern1-1"]), _Wm1);
addWopt(_rp(["Wpattern2-1"]), _Wm2);
addWopt(_rp(["Wpattern3-1", "Wpattern3-2"]), _Wm3);
/* 各パターンからは1つ以上選択される. 何個ずつ選ぶかは自動で行う(mkPattern関数). */
/**************** END OF QUESTION VARIABLES for MAIN CONTENT ******************/

/****************************** DO NOT EDIT HERE *****************************/
stack_include("https://stack.mathedu.jp/sc/mcq_template_post.txt");
/*****************************************************************************/]]></text>
