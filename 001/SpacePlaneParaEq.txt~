/*********************** SpacePlaneParaPt (rb)  *********************/
/* 001.MCB include file		                                    */
/* Objective: To learn paratrization of plane given by 3 points     */
/********************************************************************/
/* c:[3], w:[6, 6, 6]; */
%_MCQ_NUM_OPTS:4;
%_MCQ_NUM_COPTS:1;
/*******************************************/
tex2(m):=sconcat("\\(", tex1(m), "\\)");
tex2L(L):=block([s:"\\(", k], for k:1 thru length(L) do s:sconcat(s, if stringp(L[k]) then L[k] else tex1(L[k]), " "), s:sconcat(s, "\\)"), return(s));
pL:%_mk_rand_dist_pm([[1, 10], [2, 1], [3, 1], [0, 2]]);
matP:random_invertible_matrix(3, pL);
pp:col(matP, 1);
vv:col(matP, 2);
ww:col(matP, 3);
/* a+pu+qv */
pvA:pp;
pvB:pp+vv;
pvC:pp+ww;
aA:pvA;uA:pvB-pvA;vA:pvC-pvA;
aB:pvB;uB:pvA-pvB;vB:pvC-pvB;
aC:pvC;uC:pvA-pvC;vC:pvB-pvC;

PtA:tex2L(["(", sequenceify(list_matrix_entries(pvA)), ")"]);
PtB:tex2L(["(", sequenceify(list_matrix_entries(pvB)), ")"]);
PtC:tex2L(["(", sequenceify(list_matrix_entries(pvC)), ")"]);
Ceq1a:tex2L([aA, "+p", rand([-1, 1])*uA, "+q", rand([-1, 1])*vA]);
Ceq1b:tex2L([aB, "+p", rand([-1, 1])*uB, "+q", rand([-1, 1])*vB]);
Ceq1c:tex2L([aC, "+p", rand([-1, 1])*uC, "+q", rand([-1, 1])*vC]);
/* Point OK, paralle vectors NG */
Weq1a:tex2L([aA, "+p", pvB, "+q", pvC]);
Weq1b:tex2L([aB, "+p", pvA, "+q", pvC]);
Weq1c:tex2L([aC, "+p", pvA, "+q", pvB]);
Weq1d:tex2L([aA, "+p", vB, "+q", pvC]);
Weq1e:tex2L([aB, "+p", pvA, "+q", vC]);
Weq1f:tex2L([aC, "+p", vA, "+q", pvB]);
/* Point OK, 1 para */
Weq2a:tex2L([aA, "+p", uB]);
Weq2b:tex2L([aA, "+p", uC]);
Weq2c:tex2L([aB, "+p", uC]);
Weq2d:tex2L([aB, "+p", uA]);
Weq2e:tex2L([aC, "+p", uA]);
Weq2f:tex2L([aC, "+p", uB]);
/* Point NG */
Weq3a:tex2L([uA, "+p", uB, "+q", uC]);
Weq3b:tex2L([uA, "+p", uC, "+q", uA]);
Weq3c:tex2L([uB, "+p", uA, "+q", uC]);
Weq3d:tex2L([uB, "+p", uC, "+q", uA]);
Weq3e:tex2L([uC, "+p", uA, "+q", uB]);
Weq3f:tex2L([uC, "+p", uB, "+q", uA]);
/* Point NG, parallel vec NG */
Weq4a:tex2L([uA, "+p", pvB, "+q", pvC]);
Weq4b:tex2L([uA, "+p", pvC, "+q", pvA]);
Weq4c:tex2L([uB, "+p", pvA, "+q", pvC]);
Weq4d:tex2L([uB, "+p", pvC, "+q", pvA]);
Weq4e:tex2L([uC, "+p", pvA, "+q", pvB]);
Weq4f:tex2L([uC, "+p", pvB, "+q", pvA]);

/********************************** Question text ****************************************/
/* %__mcq_qtextL : question text language list                                           */
/* NOTE: In the question text, string "__SELTYPE__" is replaced automatically.           */
/*****************************************************************************************/
/* if not depend on locale, define '%__mcq_qtext'(may include __SELTYPE__) or 'qtext' directly */
%__mcq_qtextL:[["en", sconcat(__SELTYPE__, " parametric representations of the line passing through the two points A", PtA, " and B", PtB)],
 ["fr", sconcat(__SELTYPE__, " représentations paramétriques correctes de la droite passant par les deux points A", PtA, " et B", PtB)],
 ["de", sconcat(__SELTYPE__, " korrekte Parameterdarstellungen der Geraden durch die beiden Punkte A", PtA, " und B", PtB)],
 ["ja", sconcat("2点 A", PtA, ", B", PtB, "を通る直線のパラメータ表示として正しいものを__SELTYPE__")]];
/******************************** List of patterns/feedbacks *****************************/
/*  This template assumes the lists %__Copt?L, %__Wopt?L does not depend on the locale.  */
/*  If it depends on the locale, please set up the list using %_STACK_LANG.              */
