    <questionvariables>
      <text><![CDATA[/***************** 010.MatProdMatBasisVectorA *************/
/* Object: Learn about the properties of the product of ***/
/*         a matrix and a basis vector.                   */
/**********************************************************/
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.txt");
nmL:random_permutation(rand([[3,4],[3,5],[4,5]]));
num_rows:nmL[1];num_cols:nmL[2];
i0:rand(num_cols)+1;
Wei:genmatrix(lambda([i,j],if i=i0 then 1 else 0), num_cols,1);
j0:rand(num_rows)+1;
Wfj:genmatrix(lambda([i,j],if j=j0 then 1 else 0), 1, num_rows);
aL:make_random_distribution_pm([[3, 1], [2, 2], [1, 3], [0, 1]]);
matA:genmatrix(lambda([i,j], rand(aL)), num_rows, num_cols);
ta1:col(matA, i0);
ta2:[[0, false, "-"], [1, true, "列ベクトル"], [101, false, "行ベクトル"]];
ca2:1;
ta3:row(matA, j0) ;
ta4:[[0, false, "-"], [101, false, "列ベクトル"], [1, true, "行ベクトル"]];
ca4:1;
]]></text>
