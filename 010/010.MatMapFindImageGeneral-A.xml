    <questionvariables>
      <text><![CDATA[/* 1次結合の1次写像による像 */
/* v002: 解答欄補正 (2023.4.19) */
%_nr:rand(3)+2;
%_nc:rand(2)+3;

/* m x n */
matA:genmatrix(lambda([i,j],rand([-2, -1, -1, 0, 1, 1, 1, 2])), %_nr, %_nc);
getRank2(n):=block([M,k],M:genmatrix(lambda([i,j], rand([-1, 0, 0, 1, 1, 1, 2])), %_nc, 2), 
   for k:0 while (k<100 and rank(M)<2) do 
     (M:genmatrix(lambda([i, j],rand([-1, 0, 0, 1, 1, 1, 2])), %_nc, 2)), return(M));
matV:getRank2(%_nc);
v1:col(matV,1);
v2:col(matV,2);
w1:matA.v1;
w2:matA.v2;
c1:rand([-2,-1,2,3,4]);
c2:rand([-3,-2,2,3,4]);
vv:c1*v1+c2*v2;
ww:matA.vv;
ta1:c1;
ta2:c2;
ta3:ww;]]></text>
    </questionvariables>
