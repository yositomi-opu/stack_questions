    <questionvariables>
      <text>/****************** 010.MatUnitMatrixAndMatrixUnit ****************/
/* Objective: To understand the definition of a matrix unit,      */
/*              multiplication by a matrix, and the difference    */
/*              from the identity matrix                          */
/******************************************************************/
nmL:random_permutation([3, 4, 5]);
num_rows:nmL[1];num_cols:nmL[2];
matA:genmatrix(lambda([i,j], 0), num_rows, num_cols);
ijAll:makelist([floor(i/num_cols)+1, mod(i, num_cols)+1], i, 0, num_rows*num_cols-1);
ijL:random_permutation(ijAll);
ij1:ijL[1];ij2:ijL[2];ij3:ijL[3];ij4:ijL[4];ij5:ijL[5];ij6:ijL[6];
aij:random_permutation(makelist(i, i, 2, 9));
a1:aij[1];a2:aij[2];a3:aij[3];a4:aij[4];a5:aij[5];a6:aij[6];
matA[ij1[1],ij1[2]]:a1;
matA[ij2[1],ij2[2]]:-a2;
matA[ij3[1],ij3[2]]:a3;
matA[ij4[1],ij4[2]]:a4;
matA[ij5[1],ij5[2]]:-a5;
matA[ij6[1],ij6[2]]:-a6;
ta1:matA;
</text>
