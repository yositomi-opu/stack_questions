    <questionvariables>
      <text>/************** 010.MatProdAssociativeLaw ****************/
/* Object: Experience numerically that the associative   */
/*         law of multiplication holds.                  */
/*********************************************************/
/* size : p x q x r x s */
pqrs:random_permutation([2,3,3,3,4,4]);
p:pqrs[1];q:pqrs[2];r:pqrs[3];s:pqrs[4];
A:genmatrix(lambda([i,j],rand([-1,0,1,1,2])),p,q);
B:genmatrix(lambda([i,j],rand([-1,0,1,1,2,3])),q,r);
C:genmatrix(lambda([i,j],rand([-1,0,1,1,2])),r,s);
i1:rand(p)+1;
j1:rand(s)+1;
ta1:row(A.B,i1);
ta2:col(B.C,j1);
ta3:(A.B.C)[i1,j1];</text>
    </questionvariables>
