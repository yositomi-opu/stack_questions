    <questionvariables>
      <text><![CDATA[/* 1次写像による1次結合の像の計算 */
/* v003: 問題名修正 (2023.4.19) */
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.txt");
nmL:random_permutation([2,3,4]);
%_nr:nmL[1];%_nc:nmL[2];
va1:makelist([k, if k=%_nr then true else false, if k=0 then "--" else k], k, 0, 5);
va2:makelist([k, if k=%_nc then true else false, if k=0 then "--" else k], k, 0, 5);
ta1:%_nr;ta2:%_nc;/* mcq_correct(va1/va2) */
matA:genmatrix(lambda([i, j],rand([-3, -2, -2, -1, -1, 0, 1, 1, 2, 2, 3])), %_nr, %_nc);
v12:random_invertible_matrix(%_nc, [-4, -3, -2, -1, 1, 2, 3, 4]);
v1:col(v12, 1);
v2:col(v12, 2);
c12:rand([3, 5, 5, 5, 5, 7, 7, 9]);
c1:rand([-1,1])*rand([1, 2, 2, 2, 4, 4]);c2:rand([-1, 1])*(c12-abs(c1));
vv:c1*v1+c2*v2;
ta3:c1;ta4:c2;
wL:make_random_distribution_pm([[5, 1], [4, 1], [3, 1], [2, 2], [1, 5], [0, 1]]);
w1:genmatrix(lambda([i,j], rand(wL)), %_nr, 1);
w2:genmatrix(lambda([i,j], rand(wL)), %_nr, 1);
ta5:c1*w1+c2*w2;
svv:tex2(vv);]]></text>
