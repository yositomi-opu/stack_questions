    <questionvariables>
      <text>/***************** 010.MatProdDistrubutibeLaw *************/
/* Object: To understand how the distributive law holds   */
/*         using numerical examples                       */
/**********************************************************/
nn:2;mm:2;kk:2;
aL:[-3,-2,-2,-1,-1,-1,-1,0,0,1,1,1,1,2,2,3];
bL:[-2,-1,-1,0,1,1,2];
matA:genmatrix(lambda([i,j],rand(aL)), nn, mm);
matB1:genmatrix(lambda([i,j],rand(bL)), mm, kk);
matB2:genmatrix(lambda([i,j],rand(bL)), mm, kk);
ta1:matA.matB1;
ta2:matA.matB2;
ta3:matB1+matB2;
ta4:matA.ta3;
ta5:ta1+ta2
</text>
