    <questionvariables>
      <text><![CDATA[/**************** 010.MatProdDistributiveLawAndLinearity *******************/
/* Objective: Understand that linearity follows from the distributive law. */ 
/*            Note that we do not yet use the concept of a map.            */
/***************************************************************************/
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.txt");
cL:make_random_distribution_pm([[3, 1], [2, 1], [1, 4], [0, 1]])
cdM:random_matrix_det_list(2, cL, [-3, -2, -1, 1, 2, 3]);
/* c1:cdM[1,1];c2:cdM[1,2]; */
/* d1:cdM[2,1];d2:cdM[2,2]; */
c1:1;c2:0;
d1:0;d2:1;
ctosH(c,v):=if c=0 then "" elseif c=1 then v elseif c=-1 then sconcat("-",v) else sconcat(c,v);
ctosS(c,v):=if c=0 then "" elseif c>1 then sconcat("+",c,v) elseif c=1 then sconcat("+",v) elseif c=-1 then sconcat("-",v) else sconcat(c,v);

n:rand([2, 2, 2, 3, 3]);
aL:make_random_distribution_pm([[3, 1], [2, 3], [1, 4]])
vecu:genmatrix(lambda([i,j],rand(cL)),n,1);
vecv:genmatrix(lambda([i,j],rand(cL)),n,1);
vecB1:c1*vecu+d1*vecv;
vecB2:c2*vecu+d2*vecv;
p:rand_with_prohib(-4, 4, [-1, 0, 1]);
q:rand_with_prohib(-3, 3, [p, -1, 0, 1]);
ta1:p*vecu+q*vecv;
Cans1:ta1;
Qs1:display_polynomial_varlist_tex1(c1*Wu+d1*Wv, [Wu, Wv]);
Qs2:display_polynomial_varlist_tex1(c2*Wu+d2*Wv, [Wu, Wv]);
Qp:ctosH(p,"{\\mathbf u}");
Qq:if p=0 then ctosH(q,"{\\mathbf v}") else ctosS(q,"{\\mathbf v}");
Qpq:display_polynomial_varlist_tex1(p*Wu+q*Wv, [Wu, Wv]);
]]></text>
