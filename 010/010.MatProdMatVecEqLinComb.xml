      <text><![CDATA[/****************** 010.MatProdMatVecEqLinComb ***************************/
/* Object: To understand that the product of a matrix and a vector       */
/*          is a linear combination of the column vectors of the matrix, */
/*          with the components of the vector serving as coefficients.   */
/*************************************************************************/
stack_include("https://stack.mathedu.jp/sc/ky_linear_algebra.txt");
nmL:random_permutation(rand([[3, 4], [3, 5], [4, 5]]));
num_rows:nmL[1];num_cols:nmL[2];
i0:rand(num_cols)+1;
pL:makelist(p[k], k, 1, num_cols);
vP:transpose(matrix(pL));
j0:rand(num_rows)+1;
Wfj:genmatrix(lambda([i,j], if j=j0 then 1 else 0), 1, num_rows);
aL:make_random_distribution_pm([[3, 2], [2, 4], [1, 8], [0, 1]]);
matA:genmatrix(lambda([i,j], rand(aL)), num_rows, num_cols);
ta1:col(matA, 1);
ta2:col(matA, 2);
]]></text>
